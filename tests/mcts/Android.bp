package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_fwk_telephony",
}

android_test {
    name: "CtsTelecomTestCases",
    defaults: ["cts_defaults"],
    static_libs: [
        "CtsTelecomTestLib",
    ],
    sdk_version: "test_current",
    min_sdk_version: "24",
    test_suites: [
        "cts",
        "general-tests",
        "mcts-telecom",
        "mts-telecom",
    ],
    test_config: "AndroidTest.xml",
    data: [
        ":NonUiInCallServiceWoExport",
        ":ThirdPtyInCallServiceTestApp",
        ":CarModeTestAppTwo",
        ":SelfManagedCSTestAppOne",
        ":Api29InCallServiceTestApp",
        ":CallRedirectionServiceTestApp",
        ":CallRedirectionServiceTestApp2",
        ":ThirdPtyDialerTestAppTwo",
        ":ThirdPtyDialerTestApp",
        ":CarModeTestApp",
        ":CarModeTestAppSelfManaged",
        ":CallScreeningServiceTestApp",
        ":CallStreamingServiceTestApp",
        ":ThirdPartyCallIntentTestApp",
    ],
    per_testcase_directory: true,
    manifest: ":cts-telecom-test-manifest",
}

test_module_config {
    name: "CtsTelecomTestCases_PlatinumTest",
    base: "CtsTelecomTestCases",
    test_suites: ["general-tests"],
    include_annotations: ["android.platform.test.annotations.PlatinumTest"],
}
