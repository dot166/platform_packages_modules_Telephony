package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_test {
    enabled: select(release_flag("RELEASE_TELEPHONY_MODULE"), {
        true: true,
        false: false,
    }),

    name: "CtsTelephonyModuleTests",
    team: "trendy_team_fwk_telephony",
    platform_apis: true,
    min_sdk_version: "36",
    sdk_version: "test_current",

    srcs: [
        "src/**/*.java",
    ],
    libs: [
        "framework-telephony.stubs.module_lib",
    ],

    static_libs: [
        "androidx.test.runner",
        "junit",
        "telephony_aconfig_flags_lib",
        "flag-junit",
    ],

    // Tag this module as an mts test artifact
    test_suites: [
        "cts",
        "general-tests",
        "mts-telephonycore",
        "mcts-telephonycore",
    ],
}
