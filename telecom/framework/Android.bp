package {
    default_team: "trendy_team_fwk_telephony",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_defaults {
    name: "framework-telecom-defaults",
    srcs: [
        ":framework-telecomm-sources",
    ],
    visibility: [
        "//visibility:public",
    ],
    aidl: {
        include_dirs: [
            "frameworks/base/core/java",
            "frameworks/base/telephony/java",
            "frameworks/native/aidl/gui", // For Surface.java
        ],
    },
    static_libs: [
        "telecom_flags_core_java_lib",
    ],
    libs: [
        "framework-bluetooth.stubs.module_lib",
        "framework-permission.stubs.module_lib",
        "framework-permission-s.stubs.module_lib",
        "telephony_flags_core_java_exported_lib",
        "androidx.annotation_annotation",
        "app-compat-annotations",
    ],
    public: {
        libs: [
            "framework-bluetooth.stubs",
        ],
    },
    system: {
        libs: [
            "framework-bluetooth.stubs.system",
        ],
    },
    module_lib: {
        libs: [
            "framework-bluetooth.stubs.module_lib",
        ],
    },
    permitted_packages: [
        "android.telecom",
        "com.android.internal.telecom",
        "com.android.internal.telephony",
        "com.android.server.telecom",
    ],
    aconfig_declarations: [
        "telecom_flags",
    ],
    min_sdk_version: "36",
}

java_sdk_library {
    name: "framework-telecom",
    defaults: [
        "framework-module-defaults",
        "framework-telecom-defaults",
    ],
    apex_available: [
        "com.android.telephonycore",
    ],
}
