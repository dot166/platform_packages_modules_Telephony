package {
    default_team: "trendy_team_fwk_telephony",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_defaults {
    name: "framework-telecom-non-updatable-defaults",
    defaults: [
        "framework-non-updatable-unbundled-defaults",
    ],
    libs: [
        "telephony_flags_core_java_exported_lib",
    ],
    static_libs: [
        "telecom_flags_core_java_lib",
        "telecom_module_flags-export-java",
    ],
    apex_available: ["//apex_available:platform"],
}

java_defaults {
    name: "framework-telecom-updatable-defaults",
    defaults: [
        "framework-module-defaults",
    ],
    apex_available: ["com.android.telephonycore"],
    srcs: [
        ":framework-telecom-annotation-sources",
        ":framework-telecom-ext-annotation-srcs",
    ],
    static_libs: [
        "telecom_flags_core_java_aconfig_java_exported_lib",
        "telecom_module_flags-java",
        "telephony_flags_core_java_exported_lib",
        "modules-utils-build",
        "modules-utils-infra",
        "modules-utils-list-slice",
    ],
    impl_only_libs: [
        "framework-connectivity.stubs.module_lib",
        "unsupportedappusage",
    ],
    jarjar_rules: "jarjar-rules.txt",
}

soong_config_module_type {
    name: "framework_telecom_availability_soong_config",
    module_type: "java_defaults",
    config_namespace: "ANDROID",
    bool_variables: [
        "release_telecom_mainline_module",
    ],
    properties: [
        "defaults",
    ],
}

// Swap configuration related to the source of where the SDK lib lives based on the release flag.
framework_telecom_availability_soong_config {
    name: "framework-telecom-soong-availability-defaults",
    soong_config_variables: {
        release_telecom_mainline_module: {
            defaults: ["framework-telecom-updatable-defaults"],
            conditions_default: {
                defaults: ["framework-telecom-non-updatable-defaults"],
            },
        },
    },
}

java_sdk_library {
    name: "framework-telecom",
    defaults: [
        "framework-telecom-soong-availability-defaults",
    ],
    srcs: [
        ":framework-telecom-aidl-export-sources",
        ":framework-telecom-internal-sources",
    ],
    visibility: [
        "//visibility:public",
    ],
    aidl: {
        include_dirs: [
            "frameworks/base/core/java",
            "frameworks/base/telephony/java",
            "frameworks/native/aidl/gui", // For Surface.java
        ],
    },
    libs: [
        "framework-permission.stubs.module_lib",
        "framework-permission-s.stubs.module_lib",
        "androidx.annotation_annotation",
        "app-compat-annotations",
        // This strange dep is declared instead of framework-bluetooth.stubs.module_lib to break a
        // circular dep chain between Telecom, BT, tethering,and connectivity.
        "sdk_module-lib_current_framework-bluetooth",
    ],
    public: {
        libs: [
            "sdk_public_current_framework-bluetooth",
        ],
    },
    system: {
        libs: [
            "sdk_system_current_framework-bluetooth",
        ],
    },
    module_lib: {
        libs: [
            "sdk_module-lib_current_framework-bluetooth",
        ],
    },
    permitted_packages: [
        "android.telecom",
        "com.android.internal",
        "com.android.server.telecom",
    ],
    min_sdk_version: "36",
    aconfig_declarations: ["telecom_module_flags"],
}

platform_compat_config {
    name: "framework-telecom-compat-config",
    src: ":framework-telecom",
}
