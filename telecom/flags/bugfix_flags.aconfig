package: "com.android.internal.telecom.flags"
container: "com.android.telephonycore"

# OWNER=grantmenke TARGET=26Q2
 flag {
   name: "get_main_user_for_block_checker"
   namespace: "telecom"
   description: "When enabled, the block checker will use the main user's context instead of the call's associated user."
   bug: "445311509"
   metadata {
       purpose: PURPOSE_BUGFIX
   }
 }

# OWNER=tjstuart TARGET=26Q1
flag {
  name: "disconnect_on_timeout_while_disconnecting"
  namespace: "telecom"
  description: "When a call is disconnecting, if the disconnect transaction times out, force disconnect the call."
  bug: "437864306"
  metadata {
      purpose: PURPOSE_BUGFIX
  }
}

# OWNER=pmadapurmath TARGET=26Q2
flag {
  name: "skip_audio_update_to_ics"
  namespace: "telecom"
  description: "If we're in unfocused state with no calls (or all disconnected) we should skip sending an audio state update to the ICS."
  bug: "459266282"
  metadata {
      purpose: PURPOSE_BUGFIX
  }
}

# OWNER=tjstuart TARGET=26Q2
flag {
  name: "voip_background_activity_launch_fix"
  namespace: "telecom"
  description: "Fixes a bug where voip apps could not launch InCall UI when calls were answered from a bluetooth surface"
  bug: "375692816"
  metadata {
       purpose: PURPOSE_BUGFIX
  }
}

# OWNER=pmadapurmath TARGET=26Q2
flag {
  name: "quick_responses_backup"
  namespace: "telecom"
  description: "Support backup/restore for quick responses"
  bug: "458170745"
  metadata {
      purpose: PURPOSE_BUGFIX
  }
}

# OWNER=gargakash TARGET=26Q2
flag {
  name: "use_are_same_phone_number"
  namespace: "telecom"
  description: "Use PhoneNumberUtils.areSamePhoneNumber instead of compare"
  bug: "451863406"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

# OWNER=tgunn TARGET=26Q2
flag {
  name: "voip_dnd_focus"
  namespace: "telecom"
  description: "Ensure VoIP calls suppressed by DND don't get audio focus."
  bug: "421990659"
  metadata {
      purpose: PURPOSE_BUGFIX
    }
}

# OWNER=pmadapurmath TARGET=26Q2
flag {
  name: "delay_requested_handle_selection"
  namespace: "telecom"
  description: "Wait to set the requested handle until after the suggestion future to see if there are any accounts that should be prioritized."
  bug: "436290270"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}

# OWNER=tgunn TARGET=26Q2
flag {
  name: "vibration_accounts_for_main_setting"
  namespace: "telecom"
  description: "Ensures that we account for the main haptic on/off setting in addition to haptic intensity."
  bug: "408238011"
  metadata {
      purpose: PURPOSE_BUGFIX
    }
}


# OWNER=tgunn TARGET=26Q2
flag {
  name: "connection_service_bal"
  namespace: "telecom"
  description: "Limits background activity launch for a ConnectionService."
  bug: "168211626"
  metadata {
      purpose: PURPOSE_BUGFIX
    }
}

# OWNER=tjstuart TARGET=26Q2
flag {
  name: "register_bluetooth_receiver_for_all_users"
  namespace: "telecom"
  description: "Register BluetoothStateReceiver for all users to ensure Bluetooth state is tracked correctly for secondary users."
  bug: "480821340"
  metadata {
      purpose: PURPOSE_BUGFIX
  }
}

# OWNER=arunrajms TARGET=26Q3
flag {
    name: "move_get_phone_account_outside_lock"
    namespace: "telecom"
    description: "Moving the canGetPhoneAccount check outside the lock to prevent ANRs"
    bug: "451536800"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

# OWNER=breadley TARGET=26Q3
flag {
  name: "fix_transactional_call_sequencing_future"
  namespace: "telecom"
  description: "Fixes the bug in TransactionalCallSequencingAdapter where the future returned by createSetActiveTransactionSequencing is never completed."
  bug: "458829951"
  metadata {
      purpose: PURPOSE_BUGFIX
  }
}
