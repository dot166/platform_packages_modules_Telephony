package {
    default_team: "trendy_team_fwk_telephony",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aconfig_declarations {
    name: "telecom_module_flags",
    package: "android.telecom.flags",
    exportable: true,
    container: "com.android.telephonycore",
    srcs: [
        "module_flags.aconfig",
        "26Q2_migration_flags.aconfig",
    ],
}

java_aconfig_library {
    name: "telecom_module_flags-java",
    defaults: ["framework-minus-apex-aconfig-java-defaults"],
    min_sdk_version: "36",
    apex_available: [
        "com.android.telephonycore",
    ],
    aconfig_declarations: "telecom_module_flags",
}

java_aconfig_library {
    name: "telecom_module_flags-export-java",
    defaults: ["framework-minus-apex-aconfig-java-defaults"],
    min_sdk_version: "36",
    aconfig_declarations: "telecom_module_flags",
    mode: "exported",
}
