package {
    default_team: "trendy_team_fwk_telephony",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// When Telecom is compiled into telephonycore, move older 26Q2 flags that were
// not defined in module_flags.aconfig into the telephonycore container.
filegroup {
    name: "telecom_module_flags_config_src",
    srcs: [
        "module_flags.aconfig",
    ] + select(release_flag("RELEASE_TELECOM_MAINLINE_MODULE"), {
        true: ["do_not_edit_26Q2_platform_flags.aconfig"],
        false: [],
    }),
}

aconfig_declarations {
    name: "telecom_module_flags",
    package: "android.telecom.flags",
    exportable: true,
    container: "com.android.telephonycore",
    srcs: [
        ":telecom_module_flags_config_src",
    ],
}

java_aconfig_library {
    name: "telecom_module_flags-java",
    sdk_version: "module_current",
    min_sdk_version: "36",
    apex_available: [
        "com.android.telephonycore",
    ],
    aconfig_declarations: "telecom_module_flags",
}

java_aconfig_library {
    name: "telecom_module_flags-export-java",
    aconfig_declarations: "telecom_module_flags",
    sdk_version: "module_current",
    min_sdk_version: "36",
    apex_available: [
        "//apex_available:platform",
    ],
    // required here or Telecom will not be able to resolve module flags at runtime.
    jarjar_prefix: "com.android.internal.telephonycore.hidden_from_BootClassPath",
    mode: "exported",
}
