package {
    default_team: "trendy_team_fwk_telephony",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

filegroup {
    name: "framework-telephony-module-sources",
    srcs: ["java/**/*.java"],
    visibility: [
        "//packages/modules/Telephony:__subpackages__",
        "//frameworks/base:__subpackages__",
    ],
}

java_library {
    name: "framework-telephony-aidl-stubs",
    defaults: ["framework-module-defaults"],
    srcs: [
        "java/com/android/internal/telephony/IPhoneNumber.aidl",
        "java/android/telephony/ParsedPhoneNumber.aidl",
        "java/android/telephony/ParsedPhoneNumber.java",
    ],
    aidl: {
        local_include_dirs: ["java"],
    },
    apex_available: [
        "//apex_available:platform",
        "com.android.telephonycore",
    ],
    min_sdk_version: "36",
    static_libs: [
        "telephony_aconfig_flags_lib",
    ],
}

java_sdk_library {
    name: "framework-telephony",
    srcs: [":framework-telephony-module-sources"],
    defaults: ["framework-module-defaults"],
    permitted_packages: [
        "android.telephony",
        "com.android.telephony",
        "com.android.internal.telephony",
    ],
    apex_available: [
        "com.android.telephonycore",
    ],
    static_libs: [
        "telephony_aconfig_flags_lib",
        "framework-telephony-aidl-stubs",
        "telephony_libphonenumber_nogeocoder",
    ],
    min_sdk_version: "36",
    impl_library_visibility: [
        "//frameworks/base:__subpackages__",
        "//packages/modules/Telephony:__subpackages__",
    ],
    jarjar_rules: "jarjar-rules.txt",
}

java_sdk_library {
    name: "framework-platformtelephony",
    srcs: [":framework-telephony-module-sources"],
    defaults: ["framework-non-updatable-unbundled-defaults"],
    permitted_packages: [
        "android.telephony",
        "com.android.telephony",
        "com.android.internal.telephony",
    ],
    apex_available: [
        "//apex_available:platform",
    ],
    static_libs: [
        "telephony_aconfig_flags_lib",
        "framework-telephony-aidl-stubs",
        "telephony_libphonenumber_nogeocoder",
    ],
    min_sdk_version: "36",
    impl_library_visibility: [
        "//frameworks/base:__subpackages__",
        "//packages/modules/Telephony:__subpackages__",
    ],
    jarjar_rules: "jarjar-rules.txt",
}

platform_compat_config {
    name: "framework-platformtelephony-compat-config",
    src: ":framework-platformtelephony",
}
