package {
    default_team: "trendy_team_fwk_telecom",
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_visibility: [
        "//packages/services/Telecomm:__subpackages__",
        "//packages/modules/Telephony/apex:__subpackages__",
    ],
}

filegroup {
    name: "privapp_allowlist_com.android.server.telecomui",
    srcs: ["com.android.server.telecomui.xml"],
}

prebuilt_etc {
    name: "com.android.server.telecomui.xml",
    src: "com.android.server.telecomui.xml",
    sub_dir: "permissions",
    filename_from_src: true,
}

prebuilt_etc {
    name: "com.android.server.telecomui-default-permissions.xml",
    src: "com.android.server.telecomui-default-permissions.xml",
    sub_dir: "default-permissions",
    filename_from_src: true,
}
